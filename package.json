{
  "name": "raydium-bridge",
  "version": "1.0.0",
  "description": "Solana on-chain bridge using Raydium SDK",
  "main": "index.js",
  "scripts": {
    "create-tokens": "node scripts/create-tokens.js",
    "initialize-bridge": "node scripts/initialize-bridge.js",
    "create-pools": "node scripts/create-raydium-pools.js",
    "test-bridge": "node scripts/test-bridge.js",
    "monitor": "node scripts/monitor-bridge.js",
    "build-program": "cargo build-bpf --manifest-path=./bridge/program/Cargo.toml --bpf-out-dir=./dist/program",
    "deploy-program": "solana program deploy ./dist/program/raydium_bridge.so"
  },
  "keywords": [
    "solana",
    "raydium",
    "bridge",
    "blockchain"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@raydium-io/raydium-sdk": "^1.3.0",
    "@solana/spl-token": "^0.3.11",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.1",
    "buffer-layout": "^1.2.2",
    "dotenv": "^16.0.3"
  }
}
